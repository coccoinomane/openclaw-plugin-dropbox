# Dropbox credentials read by the wrapper (skills/dropbox/scripts/dropbox-mcporter.mjs).
# Copy this file somewhere private (for example ~/.openclaw/dropbox.env, mode 600),
# fill it in, and point the plugin's envFile setting (or DROPBOX_ENV_FILE) at it.
# The wrapper reads only the keys listed here. Nothing is executed.

# Recommended: app key + refresh token. The wrapper mints short-lived access
# tokens from these and caches them.
DROPBOX_APP_KEY=
DROPBOX_REFRESH_TOKEN=

# Only for apps created without PKCE ("client secret" apps). Leave empty for PKCE apps.
DROPBOX_APP_SECRET=

# Optional static access token, used when it is still valid or when no refresh
# credentials exist. Expiry accepts epoch seconds, epoch milliseconds, or ISO-8601.
DROPBOX_ACCESS_TOKEN=
DROPBOX_ACCESS_TOKEN_EXPIRES_AT=

# Legacy static token name (same meaning as DROPBOX_ACCESS_TOKEN, lower precedence).
# The mcporter config references ${DROPBOX_MCP_TOKEN}; the wrapper sets it for
# the mcporter child process, so you do not need it here once refresh works.
DROPBOX_MCP_TOKEN=
