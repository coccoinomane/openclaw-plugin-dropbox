{
  "name": "openclaw-plugin-dropbox",
  "version": "0.1.0",
  "description": "Dropbox for OpenClaw through the external mcporter CLI, with on-demand OAuth token refresh.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "src",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "openclaw": {
    "extensions": ["./index.js"],
    "compat": {
      "pluginApi": "2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "peerDependencies": {
    "openclaw": "2026.9.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "keywords": ["openclaw", "openclaw-plugin", "dropbox", "mcporter", "mcp"],
  "license": "MIT"
}
